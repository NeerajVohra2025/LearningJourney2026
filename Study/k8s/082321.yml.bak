spec:
  name: my-pv
spec:
  accessModes:
    - ReadWriteMany
    - ReadWriteOnce
    - ReadOnlyMany 
  storageClassName:   
  capacity:
     storage: 100Mi
  hostPath:
     path:  

#nfs
