#@Horizontal Pod Scalar HPA
k autoscale deploy <name> --min=2 --max=10 --cpu-percent=80

#vertical pod scalar (Increate the resources limits and request) # Limits Object type

#@job (meant for completion)
kc job myjob --image=busybox:1.28 --dry-run=client -o yaml -- /bin/sh -c 'date;sleep 3600' > job.yaml
spec:
  backoffLimit: 4 #If job fails then it will attempt 4 times
  completions: 3 # Job will be execute 3 times one-by-one
  parallelism: 4 #execute 4 jobs in parallel
  activeDeadLineSeconds: 30 #The activeDeadlineSeconds applies to the duration of the job, no matter how many Pods are created.Once a Job reaches
#  activeDeadlineSeconds, all of its running Pods are terminated and the Job status will become type: Failed with reason: DeadlineExceeded.

#@cj ( meant for schduling/batch processing)
kc cj myscheduler --image=busybox:1:28 --schedule='*/1 * * * *' --dry-run=client -o yaml -- /bin/sh -c 'date; sleep 3600' > cj.yaml
kind: CronJob
apiVersion: batch/v1beta1
metadata:
spec:
  schedule: "*/1 * * * *"
  jobTemplate:
    spec:                   # Job's specification
      backoffLimit:
      parallelism:
      completions:
      activeDeadlineSeconds:
      template:     # Pod's
        spec:
  startingDeadLineSeconds: # It stands for the deadline in seconds for starting the job if it misses its scheduled time for any reason.
