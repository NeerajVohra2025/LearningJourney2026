#@authorization
##Role (What action on Which resource - namespace specific)
kc role <name of the Role> --verb=get,list,watch --resource=pod,deployment,service -n <dev>
kc role prod-ns-view-role --verb=get,list,watch --resource=pod,deployment -n prod
kg role prod-ns-view-role -n prod
ki role prod-ns-view-role -n prod
##ClusterRole
kc clusterrole clust-admin --verb=get,list,watch,create,delete,update --resource=pod,deployment,persistentvolume,node
kg clusterrole clust-admin
ki clusterrole clust-admin

##RoleBinding ( Who can do the Role -> user/<namespace>:sa)
kc rolebinding <name of RoleBinding> --user=<name> --role=<name> -n <dev>
kc rolebinding <name of RoleBinding> --group=<devops> --role=<name> -n <dev>
kc rolebinding prod-user-binding --user=prod-user --role=prod-ns-view-role -n prod # CN

##ClusterRoleBinding ( Who can do the Role -> user/<namespace>:sa)
kc clusterrolebinding admin-binding --user=admin clusterrole=clust-admin
kc clusterrolebinding pvviewer-role-binding --serviceaccount=default:pvviewer --clusterrole=pvviewer-role

### Check access
k auth can-i create deployment
k auth can-i create Pod --as dev-user -n prod
k auth can-i <verb> <resource> --as=system:serviceaccount:<namespace>:<serviceaccountname> [-n <namespace>]
k auth can-i list pod --as=system.serviceaccount.default.admin

#certificate
## How to check the certificate
kubeadm certs check-expiration
##Manual certificate renewal
kubeadm certs renew command.
## How to view the certificate?
openssl x509 -in <.crt> -text -noout

