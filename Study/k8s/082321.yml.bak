       app: frontend

kc deploy nginx-deploy --image=nginx --port=80  --replicas=5 --dry-run=client -o yaml> nginx-deploy.yaml 

kind: Deployment		# k api-resources
apiVersion: apps/v1		# k explain < resource>
metadata:
   name:
spec:
  progressDeadLineSecods: # specifies the number of seconds you want to wait for your Deployment to progress before the system reports back that the Deployment has failed progressing 
  minReadySeconds: 20 #wait before Pod is ready to go for next
  strategy:
    type: RollingUpdate
    rolingUpdate:
       maxSurge: 1 # or 25%
       maxUnavailable: 1 or 25%
      
  replicas: 5
  template:
    metadata:
      labels:
        app: frontend
  spec:
    containers:
      - name: nginx
        image: nginx
        ports:
         - containerPort: 80 
  selector:
    matchLabels:
       app: frontend

