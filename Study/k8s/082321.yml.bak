

---
#@ create user /etc/passwd
adduser neerajv  # exception only admin can add the user
sudo adduser neerajv
sudo whoami
---
#@ add user in to the group /etc/group
sudo usermod -aG <group> <user>     # add user into the group
sudo usermod -aG docker jenkins     # add jenkins user in to the docker group

---
#@permissions (4-read,2-write,1-execute, owner group all)
sudo chmod 751 <filename>       # owner-all, group-read and execute, all-execute)
sudo chmod 751 <name of the directory> -R

---
# use script to create user DevOps, today@1234 (user,sudoers,ssh)
---
#@ add the user to the sudoers file. This file contains information that controls which users and groups are granted with sudo privelleges.
nano /etc/sudoers
neerajv ALL= (ALL) NOPASSWD:ALL
su <user>   # switch user

