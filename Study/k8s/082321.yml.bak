#@cluster upgrade
#master
k drain controlplane --ignore-daemonsets #gracefully terminate running pods and node marked as un-schedule-able
kubeadm upgrade plan
apt install kubeadm=1.20.0-00
apt install kubelet=1.20.0-00
kubeadm upgrade apply v1.20.0
service kubelet restart
k uncordon controlplane #marked as schedule-able

##wnode01
k cordon wnode01 #No termination just  node marked as un-schedule-able
ssh wnode01
apt install kubeadm=1.20.0-00
apt install kubelet=1.20.0-00
service kubelet restart
exit ssh
k uncordon wnode01 #marked as schedule-able

