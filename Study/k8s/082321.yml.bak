#declartive commands
kind: Pod    # k api-resources
apiVersion: v1 # k explain < resource>
metadata:
   namespace: dev 
   name:single-cont1
   labels:
     env: dev
     app: frontend
spec:
  serviceAccountName: admin
  containers:
     - name: nginx
       image: nginx
       ports:
         - name: webport
           containerPort: 80         
       command: ["/bin/sh","-c","date;sleep 3600"] 
       env:
         - name: name
           value: user
         - name: pin
           value: password
#@ pod-specific properties
#Specific Node ( hey! api-server please deploy at specific node)
kr nginx --image=nginx --dry-run=client -o yaml > no-scheduler.yaml
spec:
  nodeName: controlplane
# Specific Node ( hey! scheduler please deploy at node have a specific label)
kr nginx --image=nginx --dry-run=client -o yaml > ask-scheduler.yaml
spec:
  nodeSelector:
     key: value

#@affinity
kr nginx --image=nginx --dry-run=client -o yaml > affinity.yaml
spec:
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
        - matchExpressions:
          - key: kubernetes.io/e2e-az-name
            operator: In # NotIn, Exists
            values:
              - e2e-az1

#@toleration against taint
k taint node controlplane key=value:effect
k taint node controlplane key=value:effect-
kr nginx --image=nginx --dry-run=client -o yaml > toleration.yaml
spec:
 tolerations:
   - key: "color"
     operator: "Equal"
     value: "blue"  # Exists
     effect: "NoSchedule"


#securityContext
kr nginx --image=nginx --dry-run=client -o yaml > pod-security.yaml
spec:
  securityContext:
     runAsUser: 1000
     runAsGroup: 1000
     fsGroup: 2000

#volumes
kr nginx --image=nginx --port=80 --dry-run=client -o yaml > volumes.yaml
spec:
  volumes:
    - name: emptyvolume
      emptyDir: {}
    - name: persistentvolume
      persistentVolumeClaim:
        claimName:
    - name: cnfgvolume
      configMap:
        name: cnfg
    - name: scrtvolume
      secret:
        secretName:
    - name: hostvolume
      hostPath:
        path: /data/redis
        type: DirectoryOrCreate
    - name: gcvolume            # external 
      gcePersistentDisk:
         pdName: my-disk-data       # first create a disk <my-disk-data> in gc 
         fsType: ext4
    - name: awsvolume
      awsElasticBlockStorage:
         volumeID:              # first create in aws cloud
         fsType: ext4
    - name: nfsvolume
      nfs:
       path: /
       server: nfs-server.default.svc.cluster.local

#@ container-specific properties
#securityContext
kr nginx --image=nginx --dry-run=client -o yaml > container-security.yaml
spec:
  containers:
    - name: nginx
      securityContext:
         allowPrivilegeEscalation: false
         runAsUser: 2000
         capabilities:
             add: ["SYS_TIME"]
ch#resources (mandatory if ns has quota specified)
kr nginx --image=nginx --dry-run=client -o yaml > quota.yaml
kr nginx --image=nginx --requests='cpu=.5,memory=128Mi' --limits='cpu=1,memory=256Mi' --dry-run=client -o yaml > quota.yaml

spec:
  containers:
    - name: nginx
      resources:
        requests:
          cpu: "1"
          memory: 128Mi
        limits:
          cpu: "2"
          memory: 256Mi
           
#env (single value -name->value,valueFrom)
kr nginx --image=nginx --dry-run=client -o yaml > env-single.yaml
spec:
  containers:
    - name: nginx
      env:
        - name: NAME
          value: "k8s"
        - name: USER
          valueFrom:
            configMapKeyRef:
               name: mycnfgmap
               key: user
        - name: PASSWORD
          valueFrom:
             secretKeyRef:
               name: myscrt
               key: passwd
k exec nginx -- env               

#env (multiple values ->envFrom)
kr nginx --image=nginx --dry-run=client -o yaml > env-mult.yaml
spec:
  containers:
    - name: nginx
      envFrom:
        - configMapRef:
            name: mycnfgmap
        - secretRef:
            name: myscrt
k exec nginx -- env

---     
#volumeMounts
kr nginx --image=nginx --dry-run=client -o yaml > vol-mount.yaml
  containers:
    - name: nginx
      image: nginx
      volumeMounts:
         - name: emptyvolume
           mountPath: /tmp
         - name: persistvolume
           mountPath: /tmp/pvc
         - name: confvolume
           mountPath: /tmp/cnfg
         - name: secvolume
           mountPath: /tmp/sec
         - name: hostvolume
           mountPath: /tmp/usr
         - name: gcvolume
           mountPath: /tmp/gcp
         - name: awsvolume
           mountPath: /tmp/aws
         - name: nfsvolume
           mountPath: /tmp/nfs
           readOnly: true               # readOnly
---
#@probe
# livenessProbe (running application status, pod restarts the container-If application running slow due to memory)
kr nginx --image=nginx --dry-run=client -o yaml > live-probe.yaml
spec:
  containers:
    - name: nginx
      image: nginx    
      livenessProbe:
        exec:
          command:
            - ls
        httpGet:
          path:
          port:
        tcpSocket:
          port:
         
spec:
  containers:
    - name: nginx
      image: nginx
      livenessProbe:
        initialDelaySecond: 25 #  initialDelaySeconds
        periodSeconds: 20 # performProbe after periodSeconds
        timeoutSeconds:  30 #  number of seconds after that probe time out
        httpGet:
          path: /healtz
          port: 80
         
# readinessProbe (Pods status Ready, if app pod has dependency on db pod and db pod is not ready , pod will accept the traffic till dependent pod becomes ready)
kr nginx --image=nginx --dry-run=client -o yaml > ready-probe.yaml
spec:
  containers:
    - name: nginx
      image: nginx
      readinessProbe:
        initialDelaySecond: 25 #  initialDelaySeconds
        periodSeconds: 20 # performProbe after periodSeconds
        timeoutSeconds:  30 #  number of seconds after that probe time out
        httpGet:
          path: /healtz
          port: 80
         


# startupProbe (InitialDelaySecond):Legacy application takes time to start , but livenessProbe check the status of the application and 
#since its not working will restart the Pod

