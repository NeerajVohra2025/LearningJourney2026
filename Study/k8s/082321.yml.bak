#@imp paths
#k8s components
/etc/kubernetes                        # contains config files but kubelet config is missing?
/etc/kubernetes/pki                    # contains certification but kubelet certification is missing?
/etc/kubernetes/manifests              # contains .yaml but kubelet .yaml is missing? Its run as a service not a static Pod

#kubelet paths? (run as a service)
/var/lib/kubelet/config.yaml          # kubelet config
/var/lib/kubelet/pki                  # kubelet certificate
/etc/kubernetes/kubelet.conf          # in worker node default kube api server is 6443 #kubectl cluster-info
---
#@ generate token
kubeadm token create -h
kubeadm token create --print-join-command       # In master to generate a token
---
#@ how to remove from the cluster
kubeadm reset -f   #in worker node (worker node remove from cluster)
kubectl delete node wnode1   # in control-plane
