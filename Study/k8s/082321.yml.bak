ps -ef          # All running processes
---
#@shortcuts
alias k='kubectl'
alias kr='kubectl run'
alias kc='kubectl create'
alias kf='kubectl crerate -f'
alias kg='kubectl get'
alias kd='kubectl delete'
alias ki='kubectl describe'
--dry-run=client -o yaml
