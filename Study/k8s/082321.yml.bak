#user
mkdir -p /home/prod-user/certs
cd /home/prod-user/certs
##generate private key
openssl genrsa -out prod-user.key 2048
##create csr file   
openssl req -new -key prod-user.key -out prod-user.csr # common name , organization name
###request is the base64 encoded value of the CSR file content. You can get the content using this command:
cat prod-user.csr | base64 | tr -d "\n"
##create csr manifests
nano prod-user.yaml
apiVersion: certificates.k8s.io/v1
kind: CertificateSigningRequest
metadata:
  name: prod-user
spec:
  groups:
  - system:authenticated
  request: 
  signerName: kubernetes.io/kube-apiserver-client
  usages:
  - client auth
kf prod-user.yaml
kg csr   # pending approval
kubectl certificate approve prod-user # csr approved
###How user use this certificate
sudo cp /etc/kubernetes/admin.conf .
mv admin.conf prod-user.conf
###Update the prod-user.conf
####.kubeconfig Kubeconfig file is in specific format, config file has three sections Cluster, User and Context
kind: Config
apiVersion: v1
preference: {}  # current-context
clusters:
users:
contexts:


kind: Config
apiVersion: v1
clusters:
   - name:
     cluster:  
users:
   - name:
     user:      
contexts:
    - name:
      context:



kind: Config
apiVersion: v1
clusters:
   - name: k8s
     cluster:
       certificate-authority-data: # same
       server: https://127.0.0.1:6443 # same api server  
users:
   - name: prod-user  # update
     user:    
      client-certification-data / client-certification:   # -data remove exact path
      client-key-data / client-key:               # -data remove exact path
  
contexts:
    - name: prod-user-k8s
      context:
        cluster: k8s
        user: prod-user
        namespace:       # dev
    
###commands
k config -h
k config view #  default config from /.kube
k config --kubeconfig=/my-custome-config view #  custom config 
k config get-contexts # displays list of the context
k config current-context # display the current-context
k confing set-context --current --namespace=dev #permanently save the namespace for all subsequent kubectl commands in that context.
k config unset users.foo  # delete user foo
k config use-context prod-k8s-playground@prod-k8s-admin
Once we move our custom-config in to .kube/ folder then it becomes our default config

###validate
kubectl --kubeconfig=prod-user.conf version –short
kubectl --kubeconfig=prod-user.conf get nodes # As of know authenticated not authorized
