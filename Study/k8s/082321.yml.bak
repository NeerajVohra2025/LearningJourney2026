#@etcd
#backup
ETCDCTL_API=3 etcdctl snapshot save -h
ETCDCTL_API=3 etcdctl --endpoints="" --cacert="" --cert="" --key="" snapshot save /tmp/etcd-backup.db
ETCDCTL_API=3 etcdctl --endpoints="" --cacert="" --cert="" --key="" -w=table snapshot status /tmp/etcd-backup.db

#restore
ETCDCTL_API=3 etcdctl snapshot restore -h
ETCDCTL_API=3 etcdctl --data-dir= /var/lib/etcd-from-backup snapshot restore /tmp/etcd-backup.db
cat /etc/kubernetes/manifests/etcd.yaml # update the hostPath /var/lib/etcd->/var/lib/etcd-from-backup
