#@Install kubernetes
#https://v1-20.docs.kubernetes.io/docs/setup/production-environment/tools/kubeadm/install-kubeadm/
/*

*/
sudo apt-get install -y kubectl kubelet kubeadm # master 
sudo apt-get install -y kubelet kubeadm # worker node , kubectl not required
sudo apt-get install -y kubectl # jumpbox ( only kubectl client utility)
---
#@jumpbox
create user in all nodes
cp .kube/config /tmp; chmod 755 /tmp/config # exeute this command from the master
scp <devops>@<IP> :/tmp/config .        # execute in the jumpbox secure copy <user>@IP copy from /tmp/config to current
mkdir .kube
mv config .kube/

#elect the master # /etc/kubernetes/admin.conf,   /var/lib/kubelet/config.yaml 
kubeadm init
kubectl get nodes #connection refused , kubectl don't know where is api-Server    
kubectl get nodes --kubeconfig=/etc/kubernetes/admin.conf   # contains api-Server info and certificate
# set the config in class path  by default k8s read the configuration from the user's root ./kube
kubectl get nodes # status NotReady (CNI)
---
#@ CNI weave network
kubectl apply -f "https://cloud.weave.works/k8s/net?k8s-version=$(kubectl version | base64 | tr -d '\n')"
kubectl get nodes # master is in Ready state
---
#@ worker join the master
kubeadm join < token>
---
#@ validate with other user (not with root)
logout
mkdir .kube
cd .kube
sudo cp /etc/kubernetes/admin.conf config
kubectl get nodes # permission denied owner of the config file is root
sudo chown <ownwer>:<group> config # owner of the config file is devops
ls -al
kubectl get nodes # ReadyStatus
#@ validate
kubectl get pod -n kube-system # kubelet is not available ( kubelet run as a service)
service kubelet status
service kubelet start
service kubelet restart
service kubelet stop
journalctl -u kubelet
journalctl -u kubelet -f
