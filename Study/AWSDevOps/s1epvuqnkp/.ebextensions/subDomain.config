files:
  "/etc/httpd/conf.d/vhost.conf":
    mode: "000644"
    owner: root
    group: root
    encoding: plain
    content: |
      NameVirtualHost *:80

      <VirtualHost *:80>
        ServerName a.example.com
        ServerAlias example.com
        DocumentRoot /var/www/html/a/
      </VirtualHost>
      <VirtualHost *:80>
        ServerName b.example.com
        DocumentRoot /var/www/html/b/
      </VirtualHost>
