        <mxCell id="B_Rd002xboLdO3NRYGxr-1" value="&lt;b&gt;Fine tunning: Change LLMs existing behavior&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Autheticated Data Validated by Business Owner&lt;/li&gt;&lt;li&gt;Algorithim for fine tunning&lt;/li&gt;&lt;ul&gt;&lt;li&gt;PEFT: Parameter Edoption fine tuning&lt;/li&gt;&lt;li&gt;LORA (Lower ranking adoption)&amp;nbsp; # used by gemini&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="390" width="720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="B_Rd002xboLdO3NRYGxr-2" value="Google AI Studio:&lt;div&gt;&lt;ul&gt;&lt;li&gt;Tune a model&lt;/li&gt;&lt;ul&gt;&lt;li&gt;import&lt;/li&gt;&lt;li&gt;Chose a base Model # select best model&lt;/li&gt;&lt;li&gt;Advance Settings&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Tuning epoch -&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;suger Cane Machine (Number of times pass through neuro network)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Learning Rate multiplier&lt;/li&gt;&lt;ul&gt;&lt;li&gt;If pass our new data through neuro network once , then difference between actual data and prediction data is called the loss&lt;/li&gt;&lt;li&gt;steps from point A to pointB is called learning rate&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Batch Size&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="580" width="737" height="30" as="geometry" />
        </mxCell>
        <mxCell id="B_Rd002xboLdO3NRYGxr-3" value="&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Local Minima&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Global Minima&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Gain # loss rate is less&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;underfit&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;biased capability problem&lt;/span&gt;&lt;/li&gt;&lt;li&gt;wrong training&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;overfit&lt;/li&gt;&lt;ul&gt;&lt;li&gt;variance # focuced on only book&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Idlefit (Generalized)&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Optimization&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry y="740" width="784" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
