        <mxCell id="FsHeG-LxjVOUK4aDbBEi-1" value="&lt;ul&gt;&lt;li&gt;crew create flow demo_flow&lt;/li&gt;&lt;ul&gt;&lt;li&gt;myproject.tomal&lt;/li&gt;&lt;ul&gt;&lt;li&gt;All dependencies&amp;nbsp;&lt;/li&gt;&lt;li&gt;crewai install&amp;nbsp; &amp;nbsp;# install all the dependencies required to run this project&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;crewai flow kickoff&lt;/li&gt;&lt;li&gt;crewai flow plot&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
