        </mxCell>
        <mxCell id="h_oRhL3nj35upDZUtrY4-15" value="output:&lt;div&gt;Augmented Query&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
