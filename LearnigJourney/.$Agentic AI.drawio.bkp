          <mxGeometry x="40" y="890" width="618" height="276.24" as="geometry" />
        </mxCell>
        <mxCell id="ypviVlikwIPP61SqFFOu-14" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="39.999999999999986" y="1310" width="630.92" height="250" as="geometry" />
        </mxCell>
        <mxCell id="mdtNglr2BrHdQ46q-Lt3-1" value="&lt;ul&gt;&lt;li&gt;RAG&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Retrieval&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Convert data into numbers and store in vector database.&lt;/li&gt;&lt;li&gt;Embedding (Convert data into number)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Augment&lt;/li&gt;&lt;ul&gt;&lt;li&gt;set context with query(prompt)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Generation&lt;/li&gt;&lt;ul&gt;&lt;li&gt;based on context+ prompt generate response&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="1920" width="795" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mdtNglr2BrHdQ46q-Lt3-2" value="&lt;ul&gt;&lt;li&gt;Load&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Data&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Split&lt;/li&gt;&lt;ul&gt;&lt;li&gt;break it to small (splitted), chunk&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Embed&lt;/li&gt;&lt;ul&gt;&lt;li&gt;chunk data into number&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Store:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;store numbers from embedding in vector Database (Pinecone)&lt;/li&gt;&lt;li&gt;search using cosine similarty&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="1230" width="710" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mdtNglr2BrHdQ46q-Lt3-3" value="&lt;ul&gt;&lt;li&gt;pre-trained embedding model select in Retrieval&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;use the &lt;b&gt;embedded_content&lt;/b&gt; method to generate embeddings.The method handles embedding for the following tasks(task_type)&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;RETRIVAL_QUERY: specifies the given text is a query in a search/retrieval setting&lt;/li&gt;&lt;li&gt;RETRIVAL_DOCUMENT: specifies the given text is a document in a search/retrieval setting.Using this task type requires a title&lt;/li&gt;&lt;li&gt;RETRIVAL_SIMILARTIES: Specifies the given text will be used for Semantic Textual Similarties(STS)&lt;/li&gt;&lt;li&gt;CLASSIFICATION: specifies that the embedding will be used for classification&lt;/li&gt;&lt;li&gt;CLUSTERING:specifies that the embedding will be used for clustering&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="39" y="1630" width="741" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
