  <diagram id="gpvmL3_gOpHlr-cCM-A9" name="UV">
    <mxGraphModel dx="862" dy="506" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="oC9tP7hDGzLSoeqmW0We-1" value="&lt;b&gt;UV&lt;/b&gt;&lt;div&gt;&lt;b&gt;An extremly fast python package and project manager , written in Rust&lt;/b&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="oC9tP7hDGzLSoeqmW0We-2" value="&lt;ul&gt;&lt;li&gt;Unified Python&lt;/li&gt;&lt;ul&gt;&lt;li&gt;File Structure Manage&lt;/li&gt;&lt;li&gt;package downloaded parallel&lt;/li&gt;&lt;li&gt;uv (integrated with old&amp;nbsp; package managers e.g. pip,conda, poetry...)&lt;/li&gt;&lt;li&gt;dependeny resolution&amp;nbsp;&lt;/li&gt;&lt;li&gt;build in virtual environment&lt;/li&gt;&lt;li&gt;reliable dependency locking and reproduciable environment&lt;/li&gt;&lt;li&gt;memory-efficient operations, especially for large projects&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="130" width="810" height="30" as="geometry" />
        </mxCell>
        <mxCell id="oC9tP7hDGzLSoeqmW0We-3" value="steps:&lt;div&gt;&lt;ul&gt;&lt;li&gt;Install uv&lt;/li&gt;&lt;li&gt;uv version&lt;/li&gt;&lt;li&gt;uv&amp;nbsp; --help&lt;/li&gt;&lt;li&gt;uv init &amp;lt;project1&amp;gt;&lt;/li&gt;&lt;li&gt;cd project1&lt;/li&gt;&lt;li&gt;code .&lt;/li&gt;&lt;li&gt;.tomal&amp;nbsp; &amp;nbsp; # main file dependencies&lt;/li&gt;&lt;li&gt;uv run hello.py&amp;nbsp; &amp;nbsp; # will create a venv&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="60" y="240" width="730" height="30" as="geometry" />
        </mxCell>
        <mxCell id="oC9tP7hDGzLSoeqmW0We-4" value="&lt;b&gt;package : src folder&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="350" width="790" height="30" as="geometry" />
        </mxCell>
        <mxCell id="oC9tP7hDGzLSoeqmW0We-5" value="&lt;ul&gt;&lt;li&gt;cd ..&lt;/li&gt;&lt;li&gt;uv init --package &amp;lt;project2&amp;gt;&lt;/li&gt;&lt;li&gt;cd project2&lt;/li&gt;&lt;li&gt;code .&lt;/li&gt;&lt;li&gt;inside .tomal&amp;nbsp; &amp;nbsp; &amp;nbsp;# [project.scripts]&amp;nbsp; entry point for uv package&lt;/li&gt;&lt;li&gt;uv run &amp;lt;key of [project.script]&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="25" y="400" width="820" height="30" as="geometry" />
        </mxCell>
        <mxCell id="oC9tP7hDGzLSoeqmW0We-6" value="LightLLM:&lt;div&gt;&lt;ul&gt;&lt;li&gt;standard way for all LLM&lt;/li&gt;&lt;li&gt;uv add litellm&lt;/li&gt;&lt;li&gt;uv add pandas&lt;/li&gt;&lt;li&gt;uv pip install requests&amp;nbsp; &amp;nbsp;# intall in venv but not in .tomal&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="510" width="740" height="30" as="geometry" />
