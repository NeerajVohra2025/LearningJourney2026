        <mxCell id="kM24DLpgl8nsizaBYltw-1" value="Crew" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="680" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="kM24DLpgl8nsizaBYltw-2" value="Agent" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="720" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="kM24DLpgl8nsizaBYltw-3" value="crewai create flow &amp;lt;litellm1&amp;gt;&lt;div&gt;cd litellm1&lt;/div&gt;&lt;div&gt;uv run kickoff&lt;/div&gt;&lt;div&gt;uv venv&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="335" y="635" width="445" height="30" as="geometry" />
        </mxCell>
        <mxCell id="kM24DLpgl8nsizaBYltw-5" value="ollama --version&lt;div&gt;ollama ls&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="210" y="720" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="3EidikqKlcBcVjmIxhFP-1" value="&lt;b&gt;knowledge: (&lt;/b&gt;https://docs.crewai.com/concepts/knowledge)&lt;div&gt;Knowledge in CrewAI is a powerful system that allows AI agents to access and utilize external information sources during their tasks. Think of it as giving your agents a reference library they can consult while working.&lt;/div&gt;&lt;div&gt;(It embedded your data and store in Chroma Vector DB)&lt;br&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Enhance agents with domain specific information&lt;/li&gt;&lt;li&gt;Support decisions with real world data&lt;/li&gt;&lt;li&gt;maintain context across conversations&lt;/li&gt;&lt;li&gt;ground response in factual information&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="35" y="810" width="770" height="30" as="geometry" />
        </mxCell>
        <mxCell id="3EidikqKlcBcVjmIxhFP-2" value="CrewAI supports various types of knowledge source out of box&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Text Sources&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Raw String&lt;/li&gt;&lt;li&gt;Text files&lt;/li&gt;&lt;li&gt;PDF&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Structured Data&lt;/li&gt;&lt;ul&gt;&lt;li&gt;CSV&lt;/li&gt;&lt;li&gt;Excel&lt;/li&gt;&lt;li&gt;JSON&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="990" width="750" height="30" as="geometry" />
        </mxCell>
        <mxCell id="3EidikqKlcBcVjmIxhFP-4" value="&lt;b&gt;Memory (https://docs.crewai.com/concepts/memory)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="10" y="1110" width="810" height="30" as="geometry" />
        </mxCell>
        <mxCell id="3EidikqKlcBcVjmIxhFP-5" value="&lt;b&gt;Leveraging memory systems in the CrewAI framework to enhance agent capabilities&lt;/b&gt;.&lt;div&gt;The crewAI framework introduces a sophisticated memory system designed to significantly enhance the capabilities of AI agents. This system comprises short-term memory, long-term memory, entity memory, and contextual memory, each serving a unique purpose in aiding agents to remember, reason, and learn from past interactions.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="1160" width="780" height="30" as="geometry" />
        </mxCell>
        <mxCell id="3EidikqKlcBcVjmIxhFP-6" value="&lt;b&gt;Custom Tool&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="1250" width="690" height="30" as="geometry" />
        </mxCell>
        <mxCell id="3EidikqKlcBcVjmIxhFP-7" value="environment&lt;div&gt;&lt;ul&gt;&lt;li&gt;uv- project management&lt;/li&gt;&lt;li&gt;chainlit- UI&amp;nbsp;&lt;/li&gt;&lt;li&gt;litell m- can connect to any LLM&lt;/li&gt;&lt;li&gt;gemini- Free LLM&lt;/li&gt;&lt;li&gt;mcp- RAG, Function Calling,Memory&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="45" y="1320" width="760" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tFL7U1DIGDUQyRMDTfZY-1" value="&lt;ul&gt;&lt;li&gt;Crewai&lt;/li&gt;&lt;li&gt;LangGraph&lt;/li&gt;&lt;li&gt;autogen&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="528" y="1340" width="232" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tFL7U1DIGDUQyRMDTfZY-2" value="&lt;b&gt;Deployment&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="70" y="1410" width="740" height="30" as="geometry" />
        </mxCell>
        <mxCell id="87Ev-8-g14f-j7PXTCI--1" value="&lt;ul&gt;&lt;li&gt;uv run kickoff&lt;/li&gt;&lt;li&gt;Our application must return something&lt;/li&gt;&lt;li&gt;centeral file is .toml&amp;nbsp; # test with crewai run&amp;nbsp; &amp;nbsp;# to implement crew run update the .toml file&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;run_crew= same details of kickoff&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;ready for deployment&lt;/li&gt;&lt;li&gt;push to github&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="35" y="1450" width="795" height="30" as="geometry" />
        </mxCell>
