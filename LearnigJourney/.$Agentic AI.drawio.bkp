        <mxCell id="ypviVlikwIPP61SqFFOu-11" value="&lt;ul&gt;&lt;li&gt;Python&lt;/li&gt;&lt;li&gt;API Key&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Google Gemini&lt;/li&gt;&lt;li&gt;Pinecone&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
