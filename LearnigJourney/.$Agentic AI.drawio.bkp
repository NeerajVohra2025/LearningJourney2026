        <mxCell id="h_oRhL3nj35upDZUtrY4-16" value="Use the Augmented Query and LLM to generate the response" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
