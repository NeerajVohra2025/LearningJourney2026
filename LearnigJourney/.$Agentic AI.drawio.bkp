  <diagram name="CrewAI" id="ltFRkenPPX9a9Rmx5MR2">
    <mxGraphModel dx="862" dy="1606" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="NZ884iBg_qOknRInth-2-0" />
        <mxCell id="NZ884iBg_qOknRInth-2-1" parent="NZ884iBg_qOknRInth-2-0" />
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-0" value="LLM:&lt;div&gt;&lt;ul&gt;&lt;li&gt;llama3&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="30" y="70" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-1" value="Tools?&lt;div&gt;&lt;ul&gt;&lt;li&gt;A tool in CrewAI is a skill or function that agents can utilize to perform various actions . This includes tools from the CrewAI Toolkit and LangChain Tools,enabling everything from simple searches to complex interactions and effective teamwork among agents&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="20" y="150" width="710" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-3" value="from crewai_tools import (DirectoryReadTool,FileReadTool,SerperDevTool,WebSiteSearchTool)&lt;div&gt;docs_tool=DirectoryReadTool()&lt;/div&gt;&lt;div&gt;file_tool=FileReadTool()&lt;/div&gt;&lt;div&gt;search_tool=SerperDevTool()&lt;/div&gt;&lt;div&gt;web_rag_tool=WebsiteSearchTool()&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="40" y="240" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-4" value="researcher=Agent(&lt;div&gt;role=&#39;Market Research Agent&#39;,&lt;/div&gt;&lt;div&gt;goal=&#39;&#39;&lt;/div&gt;&lt;div&gt;backstory=&#39;&#39;&lt;/div&gt;&lt;div&gt;tools=[search_tool,docs_tool]&lt;/div&gt;&lt;div&gt;verbose=true&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="30" y="400" width="610" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-5" value="UseCase:&lt;div&gt;&lt;ul&gt;&lt;li&gt;Create Crew&lt;/li&gt;&lt;li&gt;Use 3 tools&lt;/li&gt;&lt;li&gt;An Agent to Google Search Website&lt;/li&gt;&lt;li&gt;An Agent to Scrape Each Website&lt;/li&gt;&lt;li&gt;An Agent to Summarize Everything&lt;/li&gt;&lt;li&gt;Save this to a file&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="20" y="570" width="690" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-6" value="&lt;b&gt;The Three Waves of AI&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="10" y="680" width="670" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-7" value="Predictive AI&lt;div&gt;&lt;ul&gt;&lt;li&gt;Focus of&amp;nbsp; analyzing data to predict outcomes.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Analyze past data &lt;/b&gt;to predict future outcome&lt;/li&gt;&lt;li&gt;&lt;b&gt;Why It matterered &lt;/b&gt;Enabled data-driven decision-making&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="50" y="770" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-8" value="Generative AI&lt;div&gt;&lt;ul&gt;&lt;li&gt;Focus on creating contents from data.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Creating Contents (text,&lt;/b&gt;image,code,videos)&lt;/li&gt;&lt;li&gt;&lt;b&gt;Why it mattered: &lt;/b&gt;Empowered creativity and productivity&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="280" y="770" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-9" value="Agentic AI&lt;div&gt;&lt;ul&gt;&lt;li&gt;Focus on autonomous actions and learning Iteratively.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Autonomous actions,&lt;/b&gt;&amp;nbsp;environment interaction,Iterative learning.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Why it mattered &lt;/b&gt;AI become proactiove ,managing complex tasks&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="550" y="780" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-11" value="Agentic AI&lt;div&gt;&lt;ul&gt;&lt;li&gt;Performs tasks anonymously&lt;/li&gt;&lt;li&gt;Analyzes data to make informed decision&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="40" y="930" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-12" value="Generative AI&lt;div&gt;&lt;ul&gt;&lt;li&gt;Requires human intervention.&lt;/li&gt;&lt;li&gt;Can only respond when given a prompt&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="560" y="920" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-13" value="!pip install&amp;nbsp; -U (Update) -q(extra dependencies quiet)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="70" y="1010" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Y8cIdyo7lGICYmTqs3E9-14" value="&lt;ul&gt;&lt;li&gt;CPU&lt;/li&gt;&lt;ul&gt;&lt;li&gt;GPU : multiple task at a time (Parallel Processing)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Memory&lt;/li&gt;&lt;li&gt;Network&lt;/li&gt;&lt;li&gt;Disk&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="40" y="1170" width="680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="wt0L_48qa_SAZvJFKq__-0" value="What is NVIDIA&#39;s CUDA?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="40" y="1250" width="690" height="30" as="geometry" />
        </mxCell>
        <mxCell id="wt0L_48qa_SAZvJFKq__-1" value="Compound AI Systems?&lt;div&gt;&lt;ul&gt;&lt;li&gt;Compound AI systems represents a significant shift in the way we approach AI development .Instead of relying on a single monolith model, these systems combine multiple AI models,tools,and techniques to create more robust,flexible and efficient solutions to complex problems.&lt;/li&gt;&lt;li&gt;Unlike traditional AI models that rely on single model, compound AI systems combine various models,retrievers,databases and external tools to enhance performance ,flexibility,and robustness.&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;LLM-&amp;gt;Compound AI Systems-&amp;gt;AI Agents&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="35" y="1350" width="780" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6GVy07iFz48uhHo5hosB-0" value="AI Agents?&lt;div&gt;&lt;ul&gt;&lt;li&gt;AI Agents represent a further evolution,embodding autonomous systems that can perceive their environment ,make decisions,and execute actions to achieve specific objective.&lt;/li&gt;&lt;li&gt;They can utilize LLMs decision-making and can interact with various tools and APIs to perform tasks such as booking appointments,managing emails.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="NZ884iBg_qOknRInth-2-1" vertex="1">
          <mxGeometry x="30" y="1480" width="790" height="30" as="geometry" />
        </mxCell>
        <mxCell id="18GobW4j_1W_l932r-v2-0" value="Text" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="NZ884iBg_qOknRInth-2-1">
          <mxGeometry x="40" y="-1070" width="60" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="r1YiISciscKHnuQd3ypm" name="langchain">
    <mxGraphModel dx="862" dy="506" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Mn_2TbsLglrn-RS_zrt7-1" value="What is LangChain?&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;box-sizing: border-box; font-weight: var(--ifm-font-weight-bold); color: rgb(28, 30, 33); font-family: &amp;quot;Public Sans&amp;quot;; font-size: 16px;&quot;&gt;LangChain&lt;/span&gt;&lt;span style=&quot;color: rgb(28, 30, 33); font-family: &amp;quot;Public Sans&amp;quot;; font-size: 16px;&quot;&gt;&amp;nbsp;is a framework for developing applications powered by large language models (LLMs).&lt;/span&gt;&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="220" width="710" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Mn_2TbsLglrn-RS_zrt7-2" value="How to create package in python?&lt;div&gt;&lt;ul&gt;&lt;li&gt;create folder India&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Inside India folder create __init_.py&lt;/li&gt;&lt;li&gt;create up.py&lt;/li&gt;&lt;ul&gt;&lt;li&gt;write some variable name (CITY=&quot;Greater Noida&quot;)&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;Incolab&lt;/li&gt;&lt;ul&gt;&lt;li&gt;from india.up import CITY&lt;/li&gt;&lt;li&gt;print (CITY)&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="770" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="IlOJzKBLX95RPkrU-DLY" name="RAG">
    <mxGraphModel dx="1712" dy="506" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="h_oRhL3nj35upDZUtrY4-1" value="RAG- Retrieval Augmented Generation (RAG)&lt;div&gt;(provide context for AI Model)&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="90" y="40" width="580" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_oRhL3nj35upDZUtrY4-2" value="&lt;ul&gt;&lt;li&gt;LLM can&#39;t answer correctly to private data.&lt;/li&gt;&lt;li&gt;LLM can&#39;t provide the real time information&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="110" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_oRhL3nj35upDZUtrY4-3" value="RAG" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.rescue;" parent="1" vertex="1">
          <mxGeometry x="110" y="160" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="h_oRhL3nj35upDZUtrY4-4" value="RAG allows LLM to use external resources for better response&lt;div&gt;&lt;ul&gt;&lt;li&gt;more accurate answers to private data&lt;/li&gt;&lt;li&gt;Stay current with new information&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="200" y="178" width="540" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_oRhL3nj35upDZUtrY4-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="h_oRhL3nj35upDZUtrY4-5" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="h_oRhL3nj35upDZUtrY4-5" value="Actor" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="270" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="h_oRhL3nj35upDZUtrY4-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" parent="1" source="h_oRhL3nj35upDZUtrY4-6" target="h_oRhL3nj35upDZUtrY4-7" edge="1">
          <mxGeometry relative="1" as="geometry" />
