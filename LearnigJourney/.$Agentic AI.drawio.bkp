        </mxCell>
        <mxCell id="Jav64uFTnfCoKmkDTRol-7" value="&lt;b&gt;Swarm Design Pattern/OpenAI Agents&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="250" y="2200" width="410" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Jav64uFTnfCoKmkDTRol-8" value="uv init --package hello_openai_agent&lt;div&gt;cd hello_openai_agent&lt;/div&gt;&lt;div&gt;code .&lt;/div&gt;&lt;div&gt;uv run &amp;lt;script&#39;s key&amp;gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="2880" width="755" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Jav64uFTnfCoKmkDTRol-9" value="uv init hello&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;# without package&amp;nbsp;&lt;div&gt;cd hello&lt;/div&gt;&lt;div&gt;code .&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;# don&#39;t have src folder&lt;/div&gt;&lt;div&gt;uv add&amp;nbsp; openai-agents python-dotenv&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; # add dependencies&lt;/div&gt;&lt;div&gt;uv run hello.py&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2950" width="660" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Jav64uFTnfCoKmkDTRol-10" value="&lt;div&gt;uv init --package hello_chainlit&lt;/div&gt;&lt;div&gt;cd hello_chainlit&lt;/div&gt;&lt;div&gt;code .&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;uv add chainlit&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;uv chainlit hello&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="3060" width="790" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Jav64uFTnfCoKmkDTRol-11" value="cd hello_chainlit&lt;div&gt;chatbot,py&lt;/div&gt;&lt;div&gt;uv run chainlit run chatbot.py -w&amp;nbsp; &amp;nbsp; &amp;nbsp; # -w flag don&#39;t restart the server&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="3130" width="720" height="30" as="geometry" />
        </mxCell>
      </root>
