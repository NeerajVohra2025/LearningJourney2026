        </mxCell>
        <mxCell id="Jav64uFTnfCoKmkDTRol-6" value="&lt;b&gt;Anthropic Design Patterns&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Prmpt Chaining(Chain Workflow)&lt;/li&gt;&lt;li&gt;Routing&lt;/li&gt;&lt;li&gt;Parallelization&lt;/li&gt;&lt;li&gt;Orchestrator-Workers&lt;/li&gt;&lt;li&gt;Evaluator-Optimizer&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
