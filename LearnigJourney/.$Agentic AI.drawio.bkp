        <mxCell id="h_oRhL3nj35upDZUtrY4-6" value="Retriver&lt;div&gt;(search external source)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="140" y="270" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="h_oRhL3nj35upDZUtrY4-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="h_oRhL3nj35upDZUtrY4-7" target="h_oRhL3nj35upDZUtrY4-8" edge="1">
          <mxGeometry relative="1" as="geometry" />
