        </mxCell>
        <mxCell id="csmLxvqocf41j_cjTG2C-28" value="&lt;ul&gt;&lt;li&gt;Job of this external stoage is&lt;/li&gt;&lt;ul&gt;&lt;li&gt;To provide the capacity to store the data&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="529" y="940" width="301" height="30" as="geometry" />
        </mxCell>
        <mxCell id="csmLxvqocf41j_cjTG2C-29" value="" style="image;aspect=fixed;perimeter=ellipsePerimeter;html=1;align=center;shadow=0;dashed=0;spacingTop=3;image=img/lib/active_directory/hard_disk.svg;" vertex="1" parent="1">
          <mxGeometry x="660" y="883" width="50" height="27" as="geometry" />
        </mxCell>
        <mxCell id="csmLxvqocf41j_cjTG2C-30" value="" style="image;aspect=fixed;perimeter=ellipsePerimeter;html=1;align=center;shadow=0;dashed=0;spacingTop=3;image=img/lib/active_directory/hard_disk.svg;" vertex="1" parent="1">
          <mxGeometry x="720" y="883" width="50" height="27" as="geometry" />
        </mxCell>
        <mxCell id="csmLxvqocf41j_cjTG2C-31" value="&lt;ul&gt;&lt;li&gt;Protocols&lt;/li&gt;&lt;ul&gt;&lt;li&gt;SAN (Storage Area Network)&lt;/li&gt;&lt;li&gt;NAS (Network Attached Storage_&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="245" y="740" width="270" height="30" as="geometry" />
        </mxCell>
        <mxCell id="csmLxvqocf41j_cjTG2C-32" value="&lt;ul&gt;&lt;li&gt;Attached the storage Volume to the server using the SAN protocol&lt;/li&gt;&lt;li&gt;Volume in the storage mount to the server as a Local disk.&lt;/li&gt;&lt;li&gt;Actual Local Disk is just a reference of actual volume in storage&lt;/li&gt;&lt;li&gt;In case of server crash, just map the same volume to the new server.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="260" y="850" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="csmLxvqocf41j_cjTG2C-33" value="Local Disk" style="sketch=0;outlineConnect=0;gradientColor=#d5739d;strokeColor=#996185;fillColor=#e6d0de;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.disk;" vertex="1" parent="1">
          <mxGeometry x="190" y="850" width="50" height="50" as="geometry" />
        </mxCell>
