        </mxCell>
        <mxCell id="fNqr4VeKU9NA6rksO2tc-8" value="&lt;div&gt;create resource.yaml:&amp;nbsp; &amp;nbsp;# yamllint.com to validate yaml file&lt;/div&gt;&lt;div&gt;# Four Important section for any type of resource in K8s&lt;/div&gt;&lt;div&gt;&lt;b&gt;kind:&lt;/b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;# resoure type Pod,Service...&lt;/div&gt;&lt;div&gt;&lt;b&gt;apiVersion&lt;/b&gt;:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;# group/version&lt;/div&gt;&lt;div&gt;&lt;b&gt;metadata&lt;/b&gt;:&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;# # data about the resource you are creating e.g name, namespace, label,annotations,deletionGracePeriodSeconds...... (dictionary)can contains any data type&lt;/div&gt;&lt;div&gt;&lt;b&gt;spec:&lt;/b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;# # specification of resource , what the resource contains e.g Pod resource contains   container, affinity,activeDeadlineSeconds (dictionary)&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="350" y="100" width="450" height="30" as="geometry" />
        </mxCell>
        <mxCell id="fNqr4VeKU9NA6rksO2tc-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="fNqr4VeKU9NA6rksO2tc-11" target="fNqr4VeKU9NA6rksO2tc-13" edge="1">
