        <mxCell id="UKc5zgxAlBxvOPDPGfUv-4" value="CSI&lt;div&gt;(Plugins)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="430" y="170" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="UKc5zgxAlBxvOPDPGfUv-9" value="&lt;ul&gt;&lt;li&gt;docker&lt;/li&gt;&lt;li&gt;podman&lt;/li&gt;&lt;li&gt;containerd&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="30" y="260" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="UKc5zgxAlBxvOPDPGfUv-10" value="&lt;ul&gt;&lt;li&gt;calllico&lt;/li&gt;&lt;li&gt;flannel&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="220" y="270" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="UKc5zgxAlBxvOPDPGfUv-11" value="&lt;ul&gt;&lt;li&gt;Kubernetes don&#39;t have native implementation&amp;nbsp;&lt;/li&gt;&lt;li&gt;Kubernetes provides plgins to integrate with third parties&lt;/li&gt;&lt;li&gt;Kubernetes don&#39;t provide any container tool&lt;/li&gt;&lt;li&gt;Kubernetes don&#39;t provide any networking tool&lt;/li&gt;&lt;li&gt;can use any third party tool must follow k8s standards (CRI,CNI,CSI)&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="410" y="60" width="410" height="30" as="geometry" />
        </mxCell>
        <mxCell id="UKc5zgxAlBxvOPDPGfUv-12" value="&lt;ul&gt;&lt;li&gt;When Install K8s , K8s CNI also get installed&lt;/li&gt;&lt;ul&gt;&lt;li&gt;dpkg -l | grep -i kube&lt;/li&gt;&lt;li&gt;Its a plugin allow to third party to integrate with k8s&lt;/li&gt;&lt;li&gt;If deploy flannel , It interact with cni plugin and CNI provides IP address to the Pod&lt;/li&gt;&lt;li&gt;kubelet interates via the CNI to the network(flannel)&lt;/li&gt;&lt;li&gt;kubectl create a Pod, Interact with the CNI plugins, CNI plugin in&amp;nbsp; background interact with third party network provides (flannel&#39;callico)&lt;/li&gt;&lt;li&gt;CRI are part of container runtime by default&lt;/li&gt;&lt;li&gt;containerd comes with inbuild cri while docker is not cri compatiable&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="380" width="670" height="30" as="geometry" />
        </mxCell>
        <mxCell id="UKc5zgxAlBxvOPDPGfUv-13" value="&lt;ul&gt;&lt;li&gt;In k8s only kubelet and container run time run as a service&amp;nbsp;&lt;/li&gt;&lt;li&gt;all other are run as a pod&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="490" width="680" height="30" as="geometry" />
        </mxCell>
