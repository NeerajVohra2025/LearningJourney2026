        <mxCell id="ABHE-3CNpKLPR8PQXFld-25" value="endpoints(podIp:containerport)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="385" y="290" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ABHE-3CNpKLPR8PQXFld-26" value="&lt;ol&gt;&lt;li&gt;Name and IP entry into DNS server in kube-system ns&lt;/li&gt;&lt;li&gt;&amp;nbsp;Pod and services are at&amp;nbsp; NS&lt;/li&gt;&lt;li&gt;service expose all the pods under Its control have the label&amp;nbsp; matches with its selector (Within the same namespace)&lt;/li&gt;&lt;li&gt;service can&#39;t see the pods which are not in its own namespace&lt;/li&gt;&lt;li&gt;kubectl get ep &amp;lt;serivice&amp;gt;&amp;nbsp; &amp;nbsp; # ep=IP:port&lt;/li&gt;&lt;/ol&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
