        </mxCell>
        <mxCell id="csmLxvqocf41j_cjTG2C-35" value="Server" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="360" y="1110" width="60" height="30" as="geometry" />
        </mxCell>
