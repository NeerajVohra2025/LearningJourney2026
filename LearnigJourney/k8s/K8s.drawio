        <mxCell id="fNqr4VeKU9NA6rksO2tc-1" value="&lt;div&gt;&lt;b&gt;Access to K8s Cluster:&lt;/b&gt;&lt;/div&gt;&lt;ul&gt;&lt;li&gt;kubectl&amp;nbsp;&lt;/li&gt;&lt;li&gt;.kube/config&lt;/li&gt;&lt;li&gt;connectivity&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
