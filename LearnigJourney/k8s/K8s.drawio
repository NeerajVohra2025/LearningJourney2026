        </mxCell>
        <mxCell id="csmLxvqocf41j_cjTG2C-37" value="Local Disk" style="sketch=0;outlineConnect=0;gradientColor=#7ea6e0;strokeColor=#6c8ebf;fillColor=#dae8fc;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.disk;" vertex="1" parent="1">
          <mxGeometry x="400" y="1050" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="csmLxvqocf41j_cjTG2C-38" value="&lt;ul&gt;&lt;li&gt;In terms of K8s , server is Pod and App is container&lt;/li&gt;&lt;li&gt;The volume from the external storage mapped to the Pod as a Volume resource&lt;/li&gt;&lt;li&gt;This Volume further mapped to the container&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
