        <mxCell id="ABHE-3CNpKLPR8PQXFld-9" value="IP randmly assigned from K8s (reserved internal range of k8s)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="230" width="350" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ABHE-3CNpKLPR8PQXFld-11" value="&lt;ul&gt;&lt;li&gt;Service has Its own IP&lt;/li&gt;&lt;li&gt;Service has Its own name&lt;/li&gt;&lt;li&gt;Service has Its own port number&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="510" y="220" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ABHE-3CNpKLPR8PQXFld-12" value="&lt;ul&gt;&lt;li&gt;Once we create a service resource&lt;/li&gt;&lt;li&gt;K8s do the following&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Creates a DNS entry for this newly created service,means Its name to be resolved to its IP address&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;kubectl get pod - n kube-system&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; # kube-dns&amp;nbsp; &amp;nbsp;pod&lt;/span&gt;&lt;/li&gt;&lt;li&gt;This DNS entry created Internally in the K8s within the dns pod&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="520" width="680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ABHE-3CNpKLPR8PQXFld-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ABHE-3CNpKLPR8PQXFld-15" target="ABHE-3CNpKLPR8PQXFld-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ABHE-3CNpKLPR8PQXFld-15" value="pod1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="80" height="80" as="geometry" />
        </mxCell>
