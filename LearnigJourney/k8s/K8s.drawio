        <mxCell id="ABHE-3CNpKLPR8PQXFld-21" value="&lt;ul&gt;&lt;li&gt;Pod names are not DNS resolve&lt;/li&gt;&lt;li&gt;POD IP are not static&lt;/li&gt;&lt;li&gt;How to communicate&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
