            <mxPoint x="200" y="221" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FAoIUK8rNZahvRhKB_qh-3" value="here are the tools" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="200" y="190" width="105" height="30" as="geometry" />
        </mxCell>
        <mxCell id="FAoIUK8rNZahvRhKB_qh-4" value="Benifit::&lt;div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;MCP resolved over burdon of writing tools schema, function logic and deploy tools on server&lt;/li&gt;&lt;li&gt;All load,calcultion responsibility moved to MCP server&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="750" width="660" height="30" as="geometry" />
        </mxCell>
