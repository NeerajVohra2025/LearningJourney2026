        <mxCell id="TWTCCFpgnW2N1NJoAgDk-9" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;div&gt;&lt;b&gt;Input guardrails&lt;/b&gt;&lt;/div&gt;&lt;div&gt;validates user prompts&lt;/div&gt;&lt;div&gt;&lt;b&gt;Output guardrails&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Validate responses&lt;/div&gt;&lt;div&gt;&lt;b&gt;Tool guardrails&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;block or allow calls&lt;/div&gt;&lt;div&gt;&lt;b&gt;Runs before&lt;/b&gt;&lt;/div&gt;&lt;div&gt;and after execution&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" vertex="1" parent="1">
