        <mxCell id="TWTCCFpgnW2N1NJoAgDk-11" value="&lt;b&gt;Level 5 enterprise clean architecture. Where each concern lives, and why domain logic must never touch the vendor SDK.&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="110" y="650" width="680" height="30" as="geometry" />
