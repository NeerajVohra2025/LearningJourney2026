        <mxCell id="TWTCCFpgnW2N1NJoAgDk-12" value="&lt;div&gt;&lt;b&gt;Layer 2 — Application (orchestration)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Manager agent · specialist agents · routing logic · handoffs · workflow steps&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;OpenAI Agents SDK lives here — agent config, handoff wiring, guardrail setup&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" vertex="1" parent="1">
