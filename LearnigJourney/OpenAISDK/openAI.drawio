        <mxCell id="TWTCCFpgnW2N1NJoAgDk-13" value="&lt;div&gt;&lt;b&gt;Layer 3 — Interface / adapters&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Tool wrappers · REST connectors · vector stores · MCP servers · web search&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Every external capability enters the system as a versioned tool function&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" vertex="1" parent="1">
