        <mxCell id="TWTCCFpgnW2N1NJoAgDk-8" value="&lt;h2 data-path-to-node=&quot;3&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/h2&gt;&lt;h2 data-path-to-node=&quot;3&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;Handsoffs&lt;/b&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;b&gt;Agent delegates&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;to the another agent&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;b&gt;Exposed as tools&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;to the LLM router&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;b&gt;Manager pattern&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;one agent Orchestrates&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;b&gt;Decentralized&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;agents hand off freely&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/h2&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" vertex="1" parent="1">
