        <mxCell id="TWTCCFpgnW2N1NJoAgDk-10" value="&lt;div&gt;&lt;b&gt;Layer 1 — Domain&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Business rules · success criteria · policies · failure conditions&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;No import from vendor SDK — fully testable and portable&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;gradientColor=#7ea6e0;strokeColor=#6c8ebf;" vertex="1" parent="1">
